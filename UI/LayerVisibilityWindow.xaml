<Window x:Class="DustyAutoCAD.UI.LayerVisibilityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dusty Robotics: Layer Visibility"
        Height="560" Width="700"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Background="#080326"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="HeaderBrush" Color="#0f0f2d"/>
        <SolidColorBrush x:Key="FgBrush"     Color="#E5E4E2"/>
        <SolidColorBrush x:Key="GrayBrush"   Color="#888888"/>
        <SolidColorBrush x:Key="BlueBrush"   Color="#5BA3F5"/>
        <SolidColorBrush x:Key="BtnNormal"   Color="#1A2A4A"/>
        <SolidColorBrush x:Key="BtnHover"    Color="#0066CC"/>
        <SolidColorBrush x:Key="RowNormal"   Color="#10102a"/>
        <SolidColorBrush x:Key="RowAlt"      Color="#161630"/>
        <SolidColorBrush x:Key="GridLine"    Color="#1E2A4A"/>

        <Style TargetType="Button">
            <Setter Property="Background"   Value="{StaticResource BtnNormal}"/>
            <Setter Property="Foreground"   Value="{StaticResource FgBrush}"/>
            <Setter Property="BorderBrush"  Value="{StaticResource GridLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"      Value="8,3"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BtnHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background"        Value="#10102a"/>
            <Setter Property="Foreground"        Value="{StaticResource FgBrush}"/>
            <Setter Property="BorderBrush"       Value="{StaticResource GridLine}"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="Padding"           Value="5,3"/>
            <Setter Property="CaretBrush"        Value="{StaticResource FgBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background"        Value="#10102a"/>
            <Setter Property="Foreground"        Value="{StaticResource FgBrush}"/>
            <Setter Property="BorderBrush"       Value="{StaticResource GridLine}"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="Padding"           Value="5,3"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background"            Value="#10102a"/>
            <Setter Property="Foreground"            Value="{StaticResource FgBrush}"/>
            <Setter Property="BorderBrush"           Value="{StaticResource GridLine}"/>
            <Setter Property="RowBackground"         Value="{StaticResource RowNormal}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource RowAlt}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource GridLine}"/>
            <Setter Property="VerticalGridLinesBrush"   Value="{StaticResource GridLine}"/>
            <Setter Property="ColumnHeaderHeight"    Value="28"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"    Value="#0f0f2d"/>
            <Setter Property="Foreground"    Value="{StaticResource BlueBrush}"/>
            <Setter Property="FontWeight"    Value="SemiBold"/>
            <Setter Property="Padding"       Value="6,4"/>
            <Setter Property="BorderBrush"   Value="{StaticResource GridLine}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1e1e40"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1A2A4A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="{StaticResource FgBrush}"/>
            <Setter Property="Padding"         Value="4,2"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1A2A4A"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="44"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="BIM One"
                           Foreground="{StaticResource BlueBrush}"
                           FontWeight="Bold" FontSize="13"
                           Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="Dusty Robotics: Layer Visibility"
                           Foreground="{StaticResource FgBrush}"
                           FontSize="13" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="✕" Width="36" Height="36"
                        FontSize="14" Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource GrayBrush}"
                        Click="BtnClose_Click"/>
            </Grid>
        </Border>

        <!-- Row 1: Toolbar -->
        <Border Grid.Row="1" Background="#0d0d28"
                BorderBrush="{StaticResource GridLine}" BorderThickness="0,0,0,1">
            <Grid Margin="8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBox x:Name="txt_search" Width="220" Height="28"
                             TextChanged="TxtSearch_TextChanged"/>
                    <Button x:Name="btn_refresh" Content="Refresh" Height="28" Width="70"
                            Margin="8,0,0,0" Click="BtnRefresh_Click"/>
                </StackPanel>
                <TextBlock x:Name="txt_count"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource GrayBrush}" FontSize="11"/>
            </Grid>
        </Border>

        <!-- Row 2: DataGrid -->
        <DataGrid Grid.Row="2" x:Name="grid_layers"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  SelectionMode="Single"
                  SelectionChanged="Grid_Layers_SelectionChanged"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Visible" Width="55"
                                        Binding="{Binding IsVisible, UpdateSourceTrigger=PropertyChanged}"/>
                <!-- Color swatch column -->
                <DataGridTemplateColumn Header="" Width="40" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Width="16" Height="16"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    CornerRadius="2"
                                    x:Name="colorSwatch"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Layer Name" Width="*"
                                    Binding="{Binding LayerName}" IsReadOnly="True"/>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <EventSetter Event="Loaded" Handler="DataGridRow_Loaded"/>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <!-- Row 3: Inspection panel -->
        <Border Grid.Row="3" Background="#080820"
                BorderBrush="{StaticResource GridLine}" BorderThickness="0,1,0,0"
                MinHeight="46" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="▸ " Foreground="{StaticResource BlueBrush}"
                           FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="txt_info"
                           Text="Select a layer row to inspect its entities."
                           Foreground="{StaticResource GrayBrush}"
                           FontSize="11" TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="2" x:Name="btn_select_in_drawing"
                        Content="Select in Drawing" Height="26" Width="130"
                        Margin="12,0,0,0"
                        IsEnabled="False"
                        Click="BtnSelectInDrawing_Click"/>
            </Grid>
        </Border>

        <!-- Row 4: Action bar -->
        <Border Grid.Row="4" Background="#0d0d28"
                BorderBrush="{StaticResource GridLine}" BorderThickness="0,1,0,1">
            <Grid Margin="8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Button x:Name="btn_all_on"  Content="All On"  Height="28" Width="65"
                            Click="BtnAllOn_Click"/>
                    <Button x:Name="btn_all_off" Content="All Off" Height="28" Width="65" Margin="6,0"
                            Click="BtnAllOff_Click"/>
                    <Button x:Name="btn_invert"  Content="Invert"  Height="28" Width="65"
                            Click="BtnInvert_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Label Content="Preset:"/>
                    <TextBox x:Name="txt_preset_name" Width="160" Height="28" Margin="4,0"/>
                    <Button x:Name="btn_save" Content="Save" Height="28" Width="55"
                            Click="BtnSave_Click"/>
                    <ComboBox x:Name="preset_combo" Width="180" Height="28" Margin="10,0,0,0"/>
                    <Button x:Name="btn_load" Content="Load" Height="28" Width="55" Margin="6,0,0,0"
                            Click="BtnLoad_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 5: Footer -->
        <Border Grid.Row="5" Background="{StaticResource HeaderBrush}"
                BorderBrush="{StaticResource GridLine}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <TextBlock x:Name="txt_status"
                           Foreground="{StaticResource GrayBrush}"
                           VerticalAlignment="Center" Text="Ready."/>
                <Button x:Name="btn_apply"
                        Content="Apply to Drawing"
                        Height="32" Width="140"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="{StaticResource BlueBrush}"
                        Foreground="White" FontWeight="SemiBold"
                        Click="BtnApply_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
