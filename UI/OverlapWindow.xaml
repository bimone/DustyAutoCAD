<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="DustyAutoCAD.UI.OverlapWindow"
    Title="Dusty: Overlap Check"
    Height="540" Width="900"
    MinHeight="400" MinWidth="700"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="#080326"
    ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="BgBrush"       Color="#080326"/>
        <SolidColorBrush x:Key="HeaderBrush"   Color="#0f0f2d"/>
        <SolidColorBrush x:Key="FgBrush"        Color="#E5E4E2"/>
        <SolidColorBrush x:Key="GrayBrush"      Color="#888888"/>
        <SolidColorBrush x:Key="BlueBrush"      Color="#5BA3F5"/>
        <SolidColorBrush x:Key="BtnNormal"      Color="#1A2A4A"/>
        <SolidColorBrush x:Key="BtnHover"       Color="#0066CC"/>
        <SolidColorBrush x:Key="WarnBrush"      Color="#F5A623"/>
        <SolidColorBrush x:Key="OkBrush"        Color="#5BA35B"/>
        <SolidColorBrush x:Key="RowNormal"      Color="#10102a"/>
        <SolidColorBrush x:Key="RowAlt"         Color="#161630"/>
        <SolidColorBrush x:Key="GridLine"       Color="#1E2A4A"/>

        <Style TargetType="Button">
            <Setter Property="Background"  Value="{StaticResource BtnNormal}"/>
            <Setter Property="Foreground"  Value="{StaticResource FgBrush}"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="5" Background="{TemplateBinding Background}" Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BtnHover}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background"            Value="{StaticResource RowNormal}"/>
            <Setter Property="Foreground"            Value="{StaticResource FgBrush}"/>
            <Setter Property="BorderThickness"       Value="0"/>
            <Setter Property="GridLinesVisibility"   Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource GridLine}"/>
            <Setter Property="RowBackground"         Value="{StaticResource RowNormal}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource RowAlt}"/>
            <Setter Property="HeadersVisibility"     Value="Column"/>
            <Setter Property="ColumnHeaderHeight"    Value="28"/>
            <Setter Property="FontSize"              Value="12"/>
            <Setter Property="SelectionMode"         Value="Single"/>
            <Setter Property="AutoGenerateColumns"   Value="False"/>
            <Setter Property="CanUserAddRows"        Value="False"/>
            <Setter Property="IsReadOnly"            Value="True"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"   Value="#0f0f2d"/>
            <Setter Property="Foreground"   Value="{StaticResource BlueBrush}"/>
            <Setter Property="Padding"      Value="8,4"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="BorderBrush"  Value="{StaticResource GridLine}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1A3A6A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding"         Value="8,3"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                <GradientStop Color="#331A4A8A" Offset="0"/>
                <GradientStop Color="#333F5EFB" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Background="{StaticResource HeaderBrush}" MouseDown="header_drag">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="BIM One" FontWeight="Heavy" FontSize="13"
                       Foreground="{StaticResource BlueBrush}" Margin="14,0,6,0"/>
            <TextBlock Grid.Column="1" Text="Dusty Robotics: Overlap Check"
                       FontSize="13" HorizontalAlignment="Center"/>
            <Button Grid.Column="2" Content="Close" Width="60" Height="22" FontSize="11"
                    Click="btn_close_click" Margin="0,0,8,0"
                    VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Background="{StaticResource HeaderBrush}" Margin="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="btn_scan" Content="Scan Drawing"
                    Height="28" Margin="10,0,6,0" Click="btn_scan_click"/>
            <Button Grid.Column="1" x:Name="btn_zoom" Content="Zoom To"
                    Height="28" Margin="0,0,10,0" Click="btn_zoom_click"
                    IsEnabled="False"/>

            <!-- Selection toggles -->
            <TextBlock Grid.Column="2" Text="Select:"
                       Foreground="{StaticResource GrayBrush}" FontSize="11"
                       Margin="0,0,6,0"/>
            <ToggleButton Grid.Column="3" x:Name="tog_line1" Content="Line 1"
                          Height="28" Width="58" Margin="0,0,3,0"
                          Click="tog_line_click" IsEnabled="False">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Background"  Value="{StaticResource BtnNormal}"/>
                        <Setter Property="Foreground"  Value="{StaticResource FgBrush}"/>
                        <Setter Property="Cursor"      Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border CornerRadius="5" Background="{TemplateBinding Background}" Padding="6,4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{StaticResource BtnHover}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
            <ToggleButton Grid.Column="4" x:Name="tog_line2" Content="Line 2"
                          Height="28" Width="58" Margin="0,0,10,0"
                          Click="tog_line_click" IsEnabled="False">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Background"  Value="{StaticResource BtnNormal}"/>
                        <Setter Property="Foreground"  Value="{StaticResource FgBrush}"/>
                        <Setter Property="Cursor"      Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border CornerRadius="5" Background="{TemplateBinding Background}" Padding="6,4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{StaticResource BtnHover}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>

            <Button Grid.Column="5" x:Name="btn_fix_selected" Content="Fix Selected"
                    Height="28" Margin="0,0,0,0" Click="btn_fix_selected_click"
                    IsEnabled="False"/>

            <TextBlock Grid.Column="6" x:Name="txt_summary"
                       Text="Click Scan Drawing to begin."
                       Foreground="{StaticResource GrayBrush}"
                       FontSize="11" Margin="12,0,0,0"/>

            <Button Grid.Column="7" x:Name="btn_fix_all" Content="Fix All"
                    Height="28" Margin="0,0,10,0" Click="btn_fix_all_click"
                    IsEnabled="False"/>
        </Grid>

        <!-- Results grid -->
        <Border Grid.Row="2" Margin="10,8,10,4"
                BorderBrush="#1E90FF" BorderThickness="1" CornerRadius="6">
            <DataGrid x:Name="grid_overlaps" SelectionChanged="grid_overlaps_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#"            Binding="{Binding RowNum}"          Width="36"/>
                    <DataGridTextColumn Header="Layer 1"     Binding="{Binding Layer1}"           Width="120"/>
                    <DataGridTextColumn Header="Layer 2"     Binding="{Binding Layer2}"           Width="120"/>
                    <DataGridTextColumn Header="Overlap"     Binding="{Binding OverlapDisplay}"   Width="76"/>
                    <DataGridTextColumn Header="Fix Action"  Binding="{Binding StrategyLabel}"    Width="200"/>
                    <DataGridTextColumn Header="Location"    Binding="{Binding Location}"         Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" Background="{StaticResource HeaderBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" FontSize="10" Margin="12,0,16,0">
                <Run Text="Powered by " Foreground="#888888"/>
                <Hyperlink RequestNavigate="Hyperlink_RequestNavigate"
                           NavigateUri="https://bimone.com"
                           Foreground="{StaticResource BlueBrush}">BIM One</Hyperlink>
            </TextBlock>
            <TextBlock Grid.Column="1" x:Name="txt_status"
                       Text="Ready." FontSize="11"
                       Foreground="{StaticResource GrayBrush}"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" x:Name="txt_note"
                       Text="Double-click a row to zoom to it."
                       FontSize="10" Foreground="{StaticResource GrayBrush}"
                       Margin="0,0,12,0"/>
        </Grid>
    </Grid>
</Window>
