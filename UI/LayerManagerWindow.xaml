<Window x:Class="DustyAutoCAD.UI.LayerManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dusty Robotics: Layer Manager"
        Height="640" Width="1100"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Background="#080326"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="HeaderBrush" Color="#0f0f2d"/>
        <SolidColorBrush x:Key="FgBrush"     Color="#E5E4E2"/>
        <SolidColorBrush x:Key="GrayBrush"   Color="#888888"/>
        <SolidColorBrush x:Key="BlueBrush"   Color="#5BA3F5"/>
        <SolidColorBrush x:Key="BtnNormal"   Color="#1A2A4A"/>
        <SolidColorBrush x:Key="BtnHover"    Color="#0066CC"/>
        <SolidColorBrush x:Key="RowNormal"   Color="#10102a"/>
        <SolidColorBrush x:Key="RowAlt"      Color="#161630"/>
        <SolidColorBrush x:Key="GridLine"    Color="#1E2A4A"/>

        <Style TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource BtnNormal}"/>
            <Setter Property="Foreground"      Value="{StaticResource FgBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource GridLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,3"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BtnHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background"             Value="#10102a"/>
            <Setter Property="Foreground"             Value="{StaticResource FgBrush}"/>
            <Setter Property="BorderBrush"            Value="{StaticResource GridLine}"/>
            <Setter Property="BorderThickness"        Value="1"/>
            <Setter Property="Padding"                Value="5,3"/>
            <Setter Property="CaretBrush"             Value="{StaticResource FgBrush}"/>
            <Setter Property="SelectionBrush"         Value="{StaticResource BlueBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background"        Value="#10102a"/>
            <Setter Property="Foreground"        Value="{StaticResource FgBrush}"/>
            <Setter Property="BorderBrush"       Value="{StaticResource GridLine}"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="Padding"           Value="5,3"/>
            <Setter Property="MaxDropDownHeight" Value="200"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press" Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="18"/>
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="0"/>
                                                <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="{StaticResource BlueBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1A2A4A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ToggleButton.Background>
                                    <SolidColorBrush Color="#10102a"/>
                                </ToggleButton.Background>
                                <ToggleButton.BorderBrush>
                                    <SolidColorBrush Color="#1E2A4A"/>
                                </ToggleButton.BorderBrush>
                                <ToggleButton.BorderThickness>
                                    <Thickness>1</Thickness>
                                </ToggleButton.BorderThickness>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="6,0,22,0"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"/>
                            <Popup x:Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False">
                                <Border Background="#10102a"
                                        BorderBrush="{StaticResource GridLine}"
                                        BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer SnapsToDevicePixels="True"
                                                  VerticalScrollBarVisibility="Auto"
                                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#10102a"/>
            <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
            <Setter Property="Padding"    Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A2A4A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1A2A4A"/>
                                <Setter Property="Foreground" Value="{StaticResource BlueBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground"       Value="{StaticResource FgBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"           Value="0,0,12,0"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background"                Value="#10102a"/>
            <Setter Property="Foreground"                Value="{StaticResource FgBrush}"/>
            <Setter Property="BorderBrush"               Value="{StaticResource GridLine}"/>
            <Setter Property="RowBackground"             Value="{StaticResource RowNormal}"/>
            <Setter Property="AlternatingRowBackground"  Value="{StaticResource RowAlt}"/>
            <Setter Property="HorizontalGridLinesBrush"  Value="{StaticResource GridLine}"/>
            <Setter Property="VerticalGridLinesBrush"    Value="{StaticResource GridLine}"/>
            <Setter Property="ColumnHeaderHeight"        Value="28"/>
            <Setter Property="EnableRowVirtualization"   Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="#0f0f2d"/>
            <Setter Property="Foreground"      Value="{StaticResource BlueBrush}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="6,4"/>
            <Setter Property="BorderBrush"     Value="{StaticResource GridLine}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1e1e40"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1A2A4A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="{StaticResource FgBrush}"/>
            <Setter Property="Padding"         Value="4,2"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1A2A4A"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground"       Value="{StaticResource FgBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding"          Value="0"/>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="{StaticResource GridLine}"/>
            <Setter Property="Margin"     Value="6,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>   <!-- 0: Header      -->
            <RowDefinition Height="44"/>   <!-- 1: Toolbar     -->
            <RowDefinition Height="*"/>    <!-- 2: DataGrid    -->
            <RowDefinition Height="Auto"/> <!-- 3: Inspection  -->
            <RowDefinition Height="44"/>   <!-- 4: Action bar  -->
            <RowDefinition Height="36"/>   <!-- 5: Options bar -->
            <RowDefinition Height="52"/>   <!-- 6: Footer      -->
        </Grid.RowDefinitions>

        <!-- ── Row 0: Header ──────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="BIM One"
                           Foreground="{StaticResource BlueBrush}"
                           FontWeight="Bold" FontSize="13"
                           Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="Dusty Robotics: Layer Manager"
                           Foreground="{StaticResource FgBrush}"
                           FontSize="13" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="✕" Width="36" Height="36"
                        FontSize="14" Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource GrayBrush}"
                        Click="BtnClose_Click"/>
            </Grid>
        </Border>

        <!-- ── Row 1: Toolbar ─────────────────────────────────────────────── -->
        <Border Grid.Row="1" Background="#0d0d28"
                BorderBrush="{StaticResource GridLine}" BorderThickness="0,0,0,1">
            <Grid Margin="8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBox x:Name="txt_search" Width="300" Height="28"
                             TextChanged="TxtSearch_TextChanged"/>
                    <Button x:Name="btn_scan" Content="Scan" Height="28" Width="60"
                            Margin="8,0,0,0" Click="BtnScan_Click"/>
                </StackPanel>
                <TextBlock x:Name="txt_count"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource GrayBrush}" FontSize="11"/>
            </Grid>
        </Border>

        <!-- ── Row 2: DataGrid ────────────────────────────────────────────── -->
        <DataGrid Grid.Row="2" x:Name="grid_layers"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  SelectionMode="Single"
                  SelectionChanged="Grid_Layers_SelectionChanged"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column">
            <DataGrid.Columns>

                <!-- 0: Include -->
                <DataGridCheckBoxColumn Header="Incl" Width="45"
                                        Binding="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- 1: Visible -->
                <DataGridCheckBoxColumn Header="Vis" Width="45"
                                        Binding="{Binding IsVisible, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- 2: Color swatch -->
                <DataGridTemplateColumn Header="" Width="35" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="colorSwatch" Width="16" Height="16"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    CornerRadius="2"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 3: Source layer -->
                <DataGridTextColumn Header="Source Layer" Width="165"
                                    Binding="{Binding SourceLayer}" IsReadOnly="True"/>

                <!-- 4: Count -->
                <DataGridTextColumn Header="Count" Width="55"
                                    Binding="{Binding ObjectCount}" IsReadOnly="True"/>

                <!-- 5: Target layer -->
                <DataGridTemplateColumn Header="→ DR- Target" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding TargetLayer, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#10102a" Foreground="#E5E4E2"
                                     BorderThickness="0" Padding="4,1"
                                     VerticalContentAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 6: Linestyle -->
                <DataGridTemplateColumn Header="Linestyle" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox SelectedItem="{Binding Linestyle, UpdateSourceTrigger=PropertyChanged}"
                                      Background="#10102a" Foreground="#E5E4E2"
                                      BorderThickness="0" Padding="4,1">
                                <ComboBoxItem>Solid</ComboBoxItem>
                                <ComboBoxItem>1 Dash 1 Dot</ComboBoxItem>
                                <ComboBoxItem>2 Dash 1 Dot</ComboBoxItem>
                                <ComboBoxItem>Soffit Framing</ComboBoxItem>
                                <ComboBoxItem>Soffit Finish</ComboBoxItem>
                                <ComboBoxItem>Duct CL</ComboBoxItem>
                                <ComboBoxItem>Lighting Fixt.</ComboBoxItem>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 7: Intent -->
                <DataGridTemplateColumn Header="Intent" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox SelectedItem="{Binding Intent, UpdateSourceTrigger=PropertyChanged}"
                                      Background="#10102a" Foreground="#E5E4E2"
                                      BorderThickness="0" Padding="4,1">
                                <ComboBoxItem>printable</ComboBoxItem>
                                <ComboBoxItem>reference</ComboBoxItem>
                                <ComboBoxItem>obstacle</ComboBoxItem>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <EventSetter Event="Loaded" Handler="DataGridRow_Loaded"/>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <!-- ── Row 3: Inspection panel ────────────────────────────────────── -->
        <Border Grid.Row="3" Background="#080820"
                BorderBrush="{StaticResource GridLine}" BorderThickness="0,1,0,0"
                MinHeight="52" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="▸ "
                           Foreground="{StaticResource BlueBrush}"
                           FontSize="11" VerticalAlignment="Top" Margin="0,2,0,0"/>
                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock x:Name="txt_info_name"
                               Text="Select a layer row to inspect its entities."
                               Foreground="#dde4f0"
                               FontSize="12" FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="txt_info_detail"
                               Text=""
                               Foreground="#7fa8e8"
                               FontSize="11" TextWrapping="Wrap"
                               Margin="0,3,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
                <Button Grid.Column="2" x:Name="btn_select_in_drawing"
                        Content="Select in Drawing" Height="26" Width="130"
                        Margin="12,0,0,0" IsEnabled="False"
                        Click="BtnSelectInDrawing_Click"/>
            </Grid>
        </Border>

        <!-- ── Row 4: Action bar ──────────────────────────────────────────── -->
        <Border Grid.Row="4" Background="#0d0d28"
                BorderBrush="{StaticResource GridLine}" BorderThickness="0,1,0,1">
            <Grid Margin="6,0">
                <!-- Left: bulk buttons -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Button x:Name="btn_all_vis_on"  Content="All Vis On"  Height="26" Padding="6,3"
                            Click="BtnAllVisOn_Click"/>
                    <Button x:Name="btn_all_vis_off" Content="All Vis Off" Height="26" Padding="6,3"
                            Margin="5,0" Click="BtnAllVisOff_Click"/>
                    <Button x:Name="btn_vis_invert"  Content="Invert"      Height="26" Padding="6,3"
                            Click="BtnVisInvert_Click"/>
                    <Separator Width="1" Height="22"/>
                    <Button x:Name="btn_all_incl"  Content="All Incl"  Height="26" Padding="6,3"
                            Click="BtnAllIncl_Click"/>
                    <Button x:Name="btn_none_incl" Content="None Incl" Height="26" Padding="6,3"
                            Margin="5,0,0,0" Click="BtnNoneIncl_Click"/>
                </StackPanel>

                <!-- Right: preset controls -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <!-- Vis presets -->
                    <Label Content="Vis Preset:" Margin="0,0,4,0"/>
                    <TextBox x:Name="txt_vis_preset" Width="100" Height="26" Margin="0,0,4,0"/>
                    <Button x:Name="btn_save_vis" Content="Save Vis" Height="26" Padding="6,3"
                            Click="BtnSaveVis_Click"/>
                    <ComboBox x:Name="combo_vis" Width="110" Height="26" Margin="4,0"/>
                    <Button x:Name="btn_load_vis" Content="Load Vis" Height="26" Padding="6,3"
                            Click="BtnLoadVis_Click"/>
                    <Separator Width="1" Height="22"/>
                    <!-- Map presets -->
                    <Label Content="Map Preset:" Margin="0,0,4,0"/>
                    <TextBox x:Name="txt_map_preset" Width="100" Height="26" Margin="0,0,4,0"/>
                    <Button x:Name="btn_save_map" Content="Save Map" Height="26" Padding="6,3"
                            Click="BtnSaveMap_Click"/>
                    <ComboBox x:Name="combo_map" Width="110" Height="26" Margin="4,0"/>
                    <Button x:Name="btn_load_map" Content="Load Map" Height="26" Padding="6,3"
                            Click="BtnLoadMap_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Row 5: Options bar ─────────────────────────────────────────── -->
        <Border Grid.Row="5" Background="#0a0a20"
                BorderBrush="{StaticResource GridLine}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                <CheckBox x:Name="chk_purge"      Content="Purge unmapped layers"/>
                <CheckBox x:Name="chk_freeze_ref" Content="Freeze reference layers"/>
            </StackPanel>
        </Border>

        <!-- ── Row 6: Footer ──────────────────────────────────────────────── -->
        <Border Grid.Row="6" Background="{StaticResource HeaderBrush}"
                BorderBrush="{StaticResource GridLine}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <TextBlock x:Name="txt_status"
                           Foreground="{StaticResource GrayBrush}"
                           VerticalAlignment="Center" Text="Ready."/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="btn_apply_map"
                            Content="Apply Mapping"
                            Height="32" Width="130"
                            Margin="0,0,8,0"
                            Click="BtnApplyMapping_Click"/>
                    <Button x:Name="btn_apply_vis"
                            Content="Apply Visibility"
                            Height="32" Width="130"
                            Background="{StaticResource BlueBrush}"
                            Foreground="White" FontWeight="SemiBold"
                            Click="BtnApplyVisibility_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
