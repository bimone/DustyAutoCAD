<Window x:Class="DustyAutoCAD.UI.DustyMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dusty AutoCAD: Layer Mapper"
        Width="760" Height="640"
        MinWidth="600" MinHeight="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="BgBrush"          Color="#080326"/>
        <SolidColorBrush x:Key="HeaderBrush"       Color="#0f0f2d"/>
        <SolidColorBrush x:Key="AccentBrush"       Color="#5BA3F5"/>
        <SolidColorBrush x:Key="HoverBrush"        Color="#0066CC"/>
        <SolidColorBrush x:Key="BtnBrush"          Color="#1A2A4A"/>
        <SolidColorBrush x:Key="FgBrush"           Color="#E0E8F8"/>
        <SolidColorBrush x:Key="MutedBrush"        Color="#8899BB"/>
        <SolidColorBrush x:Key="GridLineBrush"     Color="#1A2A4A"/>
        <SolidColorBrush x:Key="RowNormalBrush"    Color="#10102a"/>
        <SolidColorBrush x:Key="RowAltBrush"       Color="#0d0d22"/>
        <SolidColorBrush x:Key="InputBrush"        Color="#0F1840"/>

        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource BtnBrush}"/>
            <Setter Property="Foreground"      Value="{StaticResource FgBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="12,0"/>
            <Setter Property="Height"          Value="26"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#004499"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ApplyBtn" BasedOn="{StaticResource ToolBtn}" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BtnBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Width"      Value="100"/>
            <Setter Property="Height"     Value="30"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground"               Value="{StaticResource FgBrush}"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background"               Value="{StaticResource RowNormalBrush}"/>
            <Setter Property="Foreground"               Value="{StaticResource FgBrush}"/>
            <Setter Property="BorderBrush"              Value="{StaticResource GridLineBrush}"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="GridLinesVisibility"       Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource GridLineBrush}"/>
            <Setter Property="RowBackground"            Value="{StaticResource RowNormalBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource RowAltBrush}"/>
            <Setter Property="HeadersVisibility"        Value="Column"/>
            <Setter Property="ColumnHeaderHeight"       Value="30"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="SelectionMode"            Value="Single"/>
            <Setter Property="AutoGenerateColumns"      Value="False"/>
            <Setter Property="CanUserAddRows"           Value="False"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"       Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground"       Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="Padding"          Value="8,0"/>
            <Setter Property="BorderBrush"      Value="{StaticResource GridLineBrush}"/>
            <Setter Property="BorderThickness"  Value="0,0,1,1"/>
            <Setter Property="Height"           Value="30"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="6,2"/>
            <Setter Property="Foreground"      Value="{StaticResource FgBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1a2a4a"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <x:Array x:Key="LinestyleOptions" Type="sys:String"
                 xmlns:sys="clr-namespace:System;assembly=mscorlib">
            <sys:String>Solid</sys:String>
            <sys:String>1 Dash 1 Dot</sys:String>
            <sys:String>2 Dash 1 Dot</sys:String>
            <sys:String>Soffit Framing</sys:String>
            <sys:String>Soffit Finish</sys:String>
            <sys:String>Duct CL</sys:String>
            <sys:String>Lighting Fixt.</sys:String>
        </x:Array>

        <x:Array x:Key="IntentOptions" Type="sys:String"
                 xmlns:sys="clr-namespace:System;assembly=mscorlib">
            <sys:String>printable</sys:String>
            <sys:String>reference</sys:String>
            <sys:String>obstacle</sys:String>
        </x:Array>
    </Window.Resources>

    <Border Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>   <!-- Header -->
                <RowDefinition Height="40"/>   <!-- Toolbar -->
                <RowDefinition Height="*"/>    <!-- DataGrid -->
                <RowDefinition Height="32"/>   <!-- Options -->
                <RowDefinition Height="48"/>   <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- ROW 0: Header -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBrush}"
                    CornerRadius="6,6,0,0"
                    MouseLeftButtonDown="header_drag">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="BIM One"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="Bold" FontSize="13"
                                   VerticalAlignment="Center"/>
                        <Rectangle Width="1" Fill="{StaticResource GridLineBrush}" Margin="10,6"/>
                        <TextBlock Text="Dusty AutoCAD: Layer Mapper"
                                   Foreground="{StaticResource FgBrush}"
                                   FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Click="btn_close_click"
                            Width="36" Height="36"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="0,6,0,0">
                                    <TextBlock Text="x" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}" FontSize="14"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#CC2222"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ROW 1: Toolbar -->
            <Border Grid.Row="1"
                    Background="{StaticResource HeaderBrush}"
                    BorderBrush="{StaticResource GridLineBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Load Preset"
                            Style="{StaticResource ToolBtn}"
                            Click="btn_load_preset_click"/>
                    <Button Content="Save Preset"
                            Style="{StaticResource ToolBtn}"
                            Click="btn_save_preset_click"
                            Margin="6,0,0,0"/>
                    <Rectangle Width="1" Fill="{StaticResource GridLineBrush}" Margin="10,4"/>
                    <Button Content="Scan Layers"
                            Style="{StaticResource ToolBtn}"
                            Click="btn_scan_click"/>
                    <TextBlock x:Name="txt_preset_name"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11" FontStyle="Italic"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- ROW 2: DataGrid -->
            <DataGrid Grid.Row="2"
                      x:Name="grid_layers"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      SelectionUnit="FullRow"
                      VirtualizingPanel.IsVirtualizing="True">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header=""
                                            Binding="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}"
                                            Width="30"/>
                    <DataGridTextColumn Header="Source Layer"
                                        Binding="{Binding SourceLayer}"
                                        IsReadOnly="True"
                                        Width="180"/>
                    <DataGridTextColumn Header="Target Layer"
                                        Binding="{Binding TargetLayer, UpdateSourceTrigger=PropertyChanged}"
                                        Width="180"/>
                    <DataGridComboBoxColumn Header="Linestyle"
                                            SelectedItemBinding="{Binding Linestyle, UpdateSourceTrigger=PropertyChanged}"
                                            ItemsSource="{StaticResource LinestyleOptions}"
                                            Width="130"/>
                    <DataGridComboBoxColumn Header="Intent"
                                            SelectedItemBinding="{Binding Intent, UpdateSourceTrigger=PropertyChanged}"
                                            ItemsSource="{StaticResource IntentOptions}"
                                            Width="110"/>
                    <DataGridTextColumn Header="Effective Target"
                                        Binding="{Binding EffectiveTarget}"
                                        IsReadOnly="True"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- ROW 3: Options -->
            <Border Grid.Row="3"
                    Background="{StaticResource HeaderBrush}"
                    BorderBrush="{StaticResource GridLineBrush}"
                    BorderThickness="0,1,0,1"
                    Padding="12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="chk_purge"    Content="Purge excluded layers"  Margin="0,0,20,0"/>
                    <CheckBox x:Name="chk_freeze_ref" Content="Freeze reference layers"/>
                </StackPanel>
            </Border>

            <!-- ROW 4: Footer -->
            <Border Grid.Row="4"
                    Background="{StaticResource HeaderBrush}"
                    CornerRadius="0,0,6,6"
                    Padding="12,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="txt_status"
                               Grid.Column="0"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="Scan layers or load a preset to begin."/>

                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}">
                        <Run Text="Powered by "/>
                        <Hyperlink NavigateUri="https://bimone.com"
                                   RequestNavigate="Hyperlink_RequestNavigate"
                                   Foreground="{StaticResource AccentBrush}">
                            BIM One
                        </Hyperlink>
                    </TextBlock>

                    <Button x:Name="btn_apply"
                            Grid.Column="2"
                            Content="Apply"
                            Style="{StaticResource ApplyBtn}"
                            Click="btn_apply_click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
